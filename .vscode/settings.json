{
    "editor.autoSurround": "quotes",
    "editor.fontWeight": "normal",
    "editor.inlineSuggest.enabled": false,
    "editor.quickSuggestions": {
        "other": "off"
    },
    "editor.semanticHighlighting.enabled": false,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            // 注释
            {
                "scope": "comment",
                "settings": {
                    "fontStyle": "italic",
                    "foreground": "#ffff00"  
                }
            },
            
            {
                "scope": [
                    "source.python",  // resp =... (res颜色)
                    "storage.type.function.python" // def颜色
            ],
                "settings": {
                    "fontStyle": "bold",
                    "foreground": "#b20254"  // 玫红色
                }
            },
            {
                "scope": "meta.function-call.python",
                "settings": {
                    "foreground": "#ba12ed",  // 紫色
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "string",
                "settings": {
                    "fontStyle": "italic",
                    "foreground": "#12c855"  // 绿色
                }
            },
            
            //print的颜色
            {
                "scope": [
                    "entity.name.function",
                    "support.function.builtin.python",
                    "keyword.control.flow.python"

                ],
                "settings": {
                    "foreground": "#ec4517"  // 蓝色
                }
            },
            
            // 红色系 - 关键字
            {
                "scope": [
                    "keyword",
                    "keyword.control.python",
                    "support.type.exception.python"
                ],
                "settings": {
                    "foreground": "#ff0000",  // 红色
                    "fontStyle": "bold"
                }
            },
            
            // 橙色系 - 数字和参数
            {
                "scope": [
                    "constant.numeric",
                    "variable.parameter"
                ],
                "settings": {
                    "foreground": "#ff9900"  // 橙色
                }
            },
            
            // 青色系 - 类名和类型
            {
                "scope": [
                    "entity.name.type.class",
                    "support.type"
                ],
                "settings": {
                    "foreground": "#00ffff"  // 青色
                }
            },
            
            // 黄色系 - 操作符和符号
            {
                "scope": [
                    "keyword.operator",
                    "punctuation"
                ],
                "settings": {
                    "foreground": "#f7f735"  // 黄色
                }
            }

        ]
    },
    "python.languageServer": "Pylance",
    //禁用类型检查
    "python.analysis.typeCheckingMode": "off",
    // 禁用未解析模块的提示
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none"
    },
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python-envs.pythonProjects": [],
}